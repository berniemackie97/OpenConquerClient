<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenConquer.Client.Tests" />
    <InternalsVisibleTo Include="OpenConquer.Rendering.Conformance" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenConquer.Content/OpenConquer.Content.csproj" />
    <ProjectReference Include="../OpenConquer.Gameplay/OpenConquer.Gameplay.csproj" />
    <ProjectReference Include="../OpenConquer.Networking/OpenConquer.Networking.csproj" />
    <ProjectReference Include="../OpenConquer.Platform/OpenConquer.Platform.csproj" />
    <ProjectReference Include="../OpenConquer.Rendering/OpenConquer.Rendering.csproj" />
  </ItemGroup>

    <!--
     The tracked retail-5517 content set is the curated client runtime closure.
     Stage it as a unit so build and publish outputs remain identical to that tracked payload.
   -->
  <ItemGroup>
    <Content Include="../../content/retail-5517/manifest.json"
             Link="content/retail-5517/manifest.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../content/retail-5517/payload/**/*"
             Link="content/retail-5517/payload/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
