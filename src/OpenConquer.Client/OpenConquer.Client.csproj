<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Import Project="$(HOME)/.config/openconquer/client.local.props"
          Condition="'$(CI)' != 'true' and '$(OpenConquerCatalogAuthorityFile)' == '' and '$(HOME)' != '' and Exists('$(HOME)/.config/openconquer/client.local.props')" />

  <ItemGroup>
    <InternalsVisibleTo Include="OpenConquer.Client.Tests" />
    <InternalsVisibleTo Include="OpenConquer.Rendering.Conformance" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenAL" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenConquer.Content/OpenConquer.Content.csproj" />
    <ProjectReference Include="../OpenConquer.Gameplay/OpenConquer.Gameplay.csproj" />
    <ProjectReference Include="../OpenConquer.Networking/OpenConquer.Networking.csproj" />
    <ProjectReference Include="../OpenConquer.Platform/OpenConquer.Platform.csproj" />
    <ProjectReference Include="../OpenConquer.Rendering/OpenConquer.Rendering.csproj" />
  </ItemGroup>

    <!--
     The tracked retail-5517 content set is the curated client runtime closure.
     Stage it as a unit so build and publish outputs remain identical to that tracked payload.
   -->
  <ItemGroup>
    <Content Include="../../content/retail-5517/manifest.json"
             Link="content/retail-5517/manifest.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../content/retail-5517/payload/**/*"
             Link="content/retail-5517/payload/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="third-party/sharpcompress/LICENSE.txt"
             Link="third-party/sharpcompress/LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(OpenConquerCatalogAuthorityFile)' != ''">
    <EmbeddedResource Include="$(OpenConquerCatalogAuthorityFile)" LogicalName="OpenConquer.Client.Startup.Catalog.Authority.json" />
  </ItemGroup>

  <Target Name="ValidateOpenConquerCatalogAuthority" BeforeTargets="PrepareForBuild" Condition="'$(OpenConquerCatalogAuthorityFile)' != ''">
    <Error Condition="!Exists('$(OpenConquerCatalogAuthorityFile)')" Text="The explicitly configured OpenConquer catalog authority file does not exist: $(OpenConquerCatalogAuthorityFile)" />
  </Target>

  <!-- A local managed product (Product Tool create-local-product) is a development build and may carry it. -->
  <Target Name="RejectLocalRealmAuthorityPublish" BeforeTargets="ComputeFilesToPublish;Publish" Condition="'$(OpenConquerLocalRealmAuthority)' == 'true' and '$(OpenConquerLocalProduct)' != 'true'">
    <Error Text="Local development realm authority cannot be published. Pass an explicit production OpenConquerCatalogAuthorityFile, or remove ~/.config/openconquer/client.local.props." />
  </Target>

</Project>
