<Window
    x:Class="OpenConquer.Launcher.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OpenConquer"
    Width="1100"
    Height="700"
    MinWidth="800"
    MinHeight="500"
    WindowStartupLocation="CenterScreen">

  <Grid Margin="32">
    <TextBlock
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="32"
        FontWeight="SemiBold"
        Text="OpenConquer" />
  </Grid>

</Window>
