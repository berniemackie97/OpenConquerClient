{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/artifacts/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "osx-arm64",
      "inherits": "base",
      "displayName": "macOS arm64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "OPENCONQUER_RUNTIME_IDENTIFIER": "osx-arm64"
      }
    },
    {
      "name": "osx-x64",
      "inherits": "base",
      "displayName": "macOS x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "OPENCONQUER_RUNTIME_IDENTIFIER": "osx-x64"
      }
    },
    {
      "name": "linux-x64",
      "inherits": "base",
      "displayName": "Linux x64",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "OPENCONQUER_RUNTIME_IDENTIFIER": "linux-x64"
      }
    },
    {
      "name": "linux-arm64",
      "inherits": "base",
      "displayName": "Linux arm64",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "OPENCONQUER_RUNTIME_IDENTIFIER": "linux-arm64"
      }
    },
    {
      "name": "win-x64",
      "inherits": "base",
      "displayName": "Windows x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "OPENCONQUER_RUNTIME_IDENTIFIER": "win-x64"
      }
    },
    {
      "name": "win-arm64",
      "inherits": "base",
      "displayName": "Windows arm64",
      "generator": "Visual Studio 18 2026",
      "architecture": "ARM64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "OPENCONQUER_RUNTIME_IDENTIFIER": "win-arm64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "osx-arm64",
      "configurePreset": "osx-arm64",
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "osx-x64",
      "configurePreset": "osx-x64",
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64",
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-arm64",
      "configurePreset": "linux-arm64",
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "win-x64",
      "configurePreset": "win-x64",
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win-arm64",
      "configurePreset": "win-arm64",
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ]
}
