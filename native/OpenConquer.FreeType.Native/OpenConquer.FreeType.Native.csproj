<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>OpenConquer.FreeType.Native</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <PackageTitle>OpenConquer FreeType Native</PackageTitle>
    <Authors>OpenConquer</Authors>
    <Description>Reviewed first-party FreeType native runtime assets for OpenConquer.</Description>
    <PackageTags>openconquer freetype native runtime</PackageTags>
    <PackageProjectUrl>https://github.com/berniemackie97/OpenConquerClient</PackageProjectUrl>
    <PackageReadmeFile>PROVENANCE.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <PackageLicenseFile>FTL.TXT</PackageLicenseFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/berniemackie97/OpenConquerClient</RepositoryUrl>

    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <EnableDefaultItems>false</EnableDefaultItems>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <NoBuild>true</NoBuild>

    <PackageOutputPath>artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="artifacts/package/runtimes/win-x64/native/freetype.dll"
          Pack="true"
          PackagePath="runtimes/win-x64/native/"
          NativeRuntimeAsset="true" />

    <None Include="artifacts/package/runtimes/win-arm64/native/freetype.dll"
          Pack="true"
          PackagePath="runtimes/win-arm64/native/"
          NativeRuntimeAsset="true" />

    <None Include="artifacts/package/runtimes/osx-x64/native/libfreetype.dylib"
          Pack="true"
          PackagePath="runtimes/osx-x64/native/"
          NativeRuntimeAsset="true" />

    <None Include="artifacts/package/runtimes/osx-arm64/native/libfreetype.dylib"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native/"
          NativeRuntimeAsset="true" />

    <None Include="artifacts/package/runtimes/linux-x64/native/libfreetype.so"
          Pack="true"
          PackagePath="runtimes/linux-x64/native/"
          NativeRuntimeAsset="true" />

    <None Include="artifacts/package/runtimes/linux-arm64/native/libfreetype.so"
          Pack="true"
          PackagePath="runtimes/linux-arm64/native/"
          NativeRuntimeAsset="true" />

    <None Include="upstream/freetype/docs/FTL.TXT"
          Pack="true"
          PackagePath="" />

    <None Include="upstream/freetype/LICENSE.TXT"
          Pack="true"
          PackagePath="" />

    <None Include="upstream/freetype/src/bdf/README"
          Pack="true"
          PackagePath="licenses/bdf/" />

    <None Include="upstream/freetype/src/pcf/README"
          Pack="true"
          PackagePath="licenses/pcf/" />

    <None Include="PROVENANCE.md"
          Pack="true"
          PackagePath="" />
  </ItemGroup>

  <Target Name="ValidateNativePackageAssets"
          BeforeTargets="Pack">
    <ItemGroup>
      <_MissingNativeRuntimeAsset
          Include="@(None)"
          Condition="'%(None.NativeRuntimeAsset)' == 'true'
                     and !Exists('%(None.Identity)')" />
    </ItemGroup>

    <Error Condition="'@(_MissingNativeRuntimeAsset)' != ''"
           Text="Missing required native package asset(s): @(_MissingNativeRuntimeAsset, ', ')" />
  </Target>

</Project>
